{
  "name": "gillyware/atlas",
  "description": "",
  "keywords": [
    "timezones"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Bradley Johnson",
      "email": "braxey@gillyware.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "gillyware/postal": "^1.1.2",
    "illuminate/contracts": "^12.24.0",
    "illuminate/support": "^12.24.0"
  },
  "require-dev": {
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^10.6.0",
    "phpstan/phpstan": "^2.1.22",
    "phpunit/phpunit": "^12.3.4"
  },
  "autoload": {
    "psr-4": {
      "Gillyware\\Atlas\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gillyware\\Atlas\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "format": [
      "./vendor/bin/pint"
    ],
    "lint": [
      "./vendor/bin/phpstan analyse --memory-limit=2G"
    ],
    "test": [
      "./vendor/bin/phpunit"
    ],
    "sweep": [
      "composer format",
      "composer lint",
      "composer test"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Gillyware\\Atlas\\Providers\\AtlasServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
